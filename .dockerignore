.github
.git
*.md
# Fy-api overlay: re-include license files referenced by Dockerfile's
# `COPY LICENSE NOTICE THIRD-PARTY-LICENSES.md /licenses/` step.
# Upstream added this COPY without updating .dockerignore, so the build
# fails with "no items matching glob" without these unignore entries.
!LICENSE
!NOTICE
!THIRD-PARTY-LICENSES.md
.vscode
.gitignore
Makefile
docs
.eslintcache
.gocache
/web/node_modules
/web/default/node_modules
/web/default/dist
/web/classic/node_modules
/web/classic/dist
!THIRD-PARTY-LICENSES.md
