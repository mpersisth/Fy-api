# Fy-api 生产环境变量(单机 16c32g)
# 放到 /opt/fy-api/config/fy-api.env,权限 chmod 600
# 别 commit 到 git

# ==== 基础 ====
TZ=Asia/Shanghai
GIN_MODE=release
FRONTEND_BASE_URL=https://api.your-domain.com
NODE_NAME=fy-api-prod-1

# ==== 数据源 ====
# SQL_DSN:建议指向 RDS 专属代理域名(rm-xxx-proxy)而非直连
# 用 proxy 的好处:连接复用 / 读写分离 / 主备切换透明
SQL_DSN=fy_api_app:YOUR_DB_PASS@tcp(rm-xxx-proxy.mysql.rds.aliyuncs.com:3306)/fy_api?charset=utf8mb4&parseTime=True&loc=Local

# ==== Redis(你已经开好的阿里云托管实例)====
# 1) 标准格式:redis://:<密码>@<域名>:<端口>/<db>
# 2) 域名用 R-KVStore 控制台给的"内网连接地址",确保 ECS 和 Redis 在同一 VPC
# 3) 如果没设密码(阿里云免密访问模式),改成 redis://<域名>:6379/0
REDIS_CONN_STRING=redis://:YOUR_REDIS_PASS@r-xxx.redis.rds.aliyuncs.com:6379/0

# ==== 会话 / 加密(一次生成不可变 — openssl rand -hex 32 )====
SESSION_SECRET=REPLACE_ME_64_HEX_CHARS_FROM_OPENSSL_RAND
CRYPTO_SECRET=REPLACE_ME_64_HEX_CHARS_FROM_OPENSSL_RAND

# ==== 性能(16c32g 规格对应值)====
GOMAXPROCS=12
GOMEMLIMIT=20000MiB

# 上游 HTTP 连接池(对应 OpenAI/Anthropic/Gemini 等)
RELAY_MAX_IDLE_CONNS=10000
RELAY_MAX_IDLE_CONNS_PER_HOST=1000
RELAY_TIMEOUT=600
STREAMING_TIMEOUT=300

# DB 连接池
SQL_MAX_IDLE_CONNS=100
SQL_MAX_OPEN_CONNS=500

# 内存缓存 + 批量写(必开,否则 DB CPU 会被打满)
MEMORY_CACHE_ENABLED=true
SYNC_FREQUENCY=60
BATCH_UPDATE_ENABLED=true
BATCH_UPDATE_INTERVAL=3

# ==== 日志 ====
ERROR_LOG_ENABLED=true

# ==== 限流(16c32g 放宽,业务起量后调整)====
GLOBAL_API_RATE_LIMIT_ENABLE=true
GLOBAL_API_RATE_LIMIT=6000
GLOBAL_API_RATE_LIMIT_DURATION=60

GLOBAL_WEB_RATE_LIMIT_ENABLE=true
GLOBAL_WEB_RATE_LIMIT=240
GLOBAL_WEB_RATE_LIMIT_DURATION=60

CRITICAL_RATE_LIMIT_ENABLE=true
CRITICAL_RATE_LIMIT=100
CRITICAL_RATE_LIMIT_DURATION=1200

SEARCH_RATE_LIMIT_ENABLE=true
SEARCH_RATE_LIMIT=30
SEARCH_RATE_LIMIT_DURATION=60

# ==== 模型请求限流(按客户分组,热更新) ====
# 这里的开关也可以走数据库 options 表改,详见 rate-limiting.md
# 默认关闭,后台启用后生效

# ==== 其他 ====
# 不设 LOG_DIR env,我们通过 command: ["--log-dir=/app/logs"] 传 CLI 参数
